{
    "name": "tienda-y-abarrotes/app",
    "type": "project",
    "description": "Sistema de punto de venta e inventario para tienda de abarrotes - CodeIgniter 4",
    "homepage": "https://codeigniter.com",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pgsql": "*",
        "codeigniter4/framework": "4.7.*",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
