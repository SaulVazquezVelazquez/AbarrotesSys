CI_ENVIRONMENT = development

APP_BASEURL = 'http://localhost:8888/tienda_barrio/'

# Conexión local de PostgreSQL (coincide con app/Config/Database.php)
DB_HOSTNAME = 127.0.0.1
DB_DATABASE = tienda_abarrotes
DB_USERNAME = postgres
DB_PASSWORD = root
DB_PORT = 5432

# En Render se genera automáticamente desde render.yaml.
# Para producción local puedes definir una clave privada de al menos 32 caracteres.
ENCRYPTION_KEY =
COOKIE_SECURE = false
